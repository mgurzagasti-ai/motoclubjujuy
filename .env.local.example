# Ejemplo sin secretos. Completar solo con valores del proyecto Supabase existente
# si se decide conectar esta PC a ese proyecto. No usar un proyecto nuevo.
# La clave publicable se usa en el navegador para leer contenido.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-existente.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR_CLAVE_PUBLICA

# La clave secreta queda exclusivamente en el servidor local.
# El nombre de esta variable es el que espera el codigo actual.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CLAVE_SERVIDOR

# Credenciales de ADMIN autorizadas para el entorno que se vaya a usar.
ADMIN_USERNAME=REEMPLAZAR_USUARIO
ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_UNICA
